{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and account balance",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "balance": { "type": "number", "description": "Account balance in INR" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "apiKey": { "type": "string", "description": "API key for reseller access" },
        "currencyPreference": { "type": "string", "default": "INR" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "balance", "role"]
    },
    "Service": {
      "title": "Service",
      "description": "SMM service details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "platform": { "type": "string", "description": "Instagram, YouTube, etc." },
        "rate": { "type": "number", "description": "Price per 1000 units in INR" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "description": { "type": "string" },
        "providerId": { "type": "string" },
        "externalServiceId": { "type": "string" },
        "dripFeedEnabled": { "type": "boolean" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "category", "rate", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "SMM order details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "serviceId": { "type": "string" },
        "link": { "type": "string" },
        "quantity": { "type": "number" },
        "charge": { "type": "number", "description": "Charge in INR" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "partial", "canceled", "refunded"] },
        "isDripFeed": { "type": "boolean" },
        "runs": { "type": "number" },
        "interval": { "type": "number" },
        "totalQuantity": { "type": "number" },
        "refillStatus": { "type": "string", "enum": ["none", "pending", "completed", "rejected"] },
        "externalOrderId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "serviceId", "link", "quantity", "charge", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Wallet deposit or order charge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number", "description": "Amount in INR" },
        "type": { "type": "string", "enum": ["deposit", "charge", "refund"] },
        "method": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "utr": { "type": "string", "description": "12-digit UPI Transaction ID" },
        "currency": { "type": "string" },
        "exchangeRate": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "type", "status"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "Support ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "answered", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subject", "message", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Available SMM services"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial records"
    },
    "/tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Support tickets"
    }
  }
}
